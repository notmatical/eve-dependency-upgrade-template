{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "bun"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "#*": [
        "./agent/*"
      ],
      "#evals/*": [
        "./evals/*"
      ]
    }
  },
  "include": [
    "agent/**/*.ts",
    "evals/**/*.ts",
    "scripts/**/*.ts",
    "lockstep.config.ts"
  ]
}