{
  "name": "eve-dependency-upgrade-template",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start",
    "eval": "eve eval",
    "test": "bun test agent",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun run test",
    "fixtures:check": "bun scripts/check-fixtures.ts",
    "fixtures:capture": "bun scripts/capture-failures.ts",
    "corpus": "bun scripts/run-corpus.ts"
  },
  "dependencies": {
    "@github-tools/eve-extension": "0.5.0",
    "@vercel/connect": "^2.0.0",
    "eve": "0.47.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "just-bash": "^3.4.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}